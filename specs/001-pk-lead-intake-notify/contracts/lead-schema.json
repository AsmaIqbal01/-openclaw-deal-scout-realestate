{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PK Lead (Intake → Delivery contract)",
  "description": "Structured JSON contract the Intake Sub-Agent MUST produce and the Delivery Sub-Agent MUST validate before taking any action (spec.md FR-004). PK-scoped subset of the full lead schema in agents/intake/SOUL.md.",
  "type": "object",
  "required": [
    "lead_id",
    "tenant_id",
    "source",
    "market_mode",
    "classification_score",
    "raw_source_id",
    "classified_at"
  ],
  "properties": {
    "lead_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "enum": ["zameen_alert", "olx_alert", "whatsapp_forward"]
    },
    "market_mode": { "const": "PK" },
    "contact": {
      "type": "object",
      "properties": {
        "name": { "type": ["string", "null"] },
        "email": { "type": ["string", "null"] },
        "phone": { "type": ["string", "null"] },
        "whatsapp": { "type": ["string", "null"] }
      }
    },
    "property": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["residential", "commercial", "plot", "rental", "unknown"]
        },
        "location": { "type": ["string", "null"] },
        "budget_pkr": { "type": ["number", "null"] },
        "size": { "type": ["string", "null"] }
      }
    },
    "urgency": { "type": "string", "enum": ["high", "medium", "low"] },
    "classification_score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
    "rejection_reason": { "type": ["string", "null"] },
    "raw_source_id": { "type": "string", "minLength": 1 },
    "classified_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
